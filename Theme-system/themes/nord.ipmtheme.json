  "license": "MIT",
  "homepage": "https://www.nordtheme.com/",
  "screenshot": "nord.png",
  "base": "modern-dark",
  "font_family": "Segoe UI",
  "colors": {
    "bg": "#2e3440",
    "panel": "#3b4252",
    "text": "#eceff4",
    "muted": "#a7b1c2",
    "accent": "#88c0d0",
    "accent_active": "#81a1c1",
    "danger": "#bf616a",
    "danger_active": "#a54e57",
    "border": "#434c5e",
    "selection": "#5e81ac",
    "tree_bg": "#3b4252",
    "tree_heading_bg": "#434c5e",
    "tree_heading_fg": "#eceff4",
    "tab_bg": "#3b4252",
    "tab_selected_bg": "#2e3440",
    "accent_text": "#2e3440",
    "selection_fg": "#eceff4"
